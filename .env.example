# ──────────────────────────────────────────────────
# GenAI Studio — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.
# ──────────────────────────────────────────────────

# ── Appwrite (Required) ───────────────────────────
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_PROJECT_NAME=your_project_name
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_COLLECTION_ID=your_collection_id
VITE_APPWRITE_BUCKET_ID=your_bucket_id

# Passkey required to upload photos to the community gallery
VITE_UPLOAD_PASSKEY=your_upload_passkey

# ── AI API Keys (Optional — users can also paste their own in the UI) ─
# Leave blank if you want users to bring their own keys via the UI.

# Hugging Face Access Token → https://huggingface.co/settings/tokens
VITE_HF_API_KEY=

# Google Gemini API Key → https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenAI API Key → https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Pollinations API Key → https://auth.pollinations.ai
VITE_POLLINATIONS_API_KEY=
